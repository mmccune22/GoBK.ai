---
/** Structural callout for caveats and jurisdiction notes inside articles. */
interface Props { title: string }
const { title } = Astro.props;
---
<aside class="callout">
  <p class="callout-title">{title}</p>
  <div class="callout-body"><slot /></div>
</aside>
<style>
  .callout {
    background: var(--grey); border-left: 5px solid var(--sage);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
    margin: 1.8em 0;
        font-size: 1rem;
    line-height: 1.55;
  }
  .callout-title { font-weight: 600; margin: 0 0 0.35em; color: var(--evergreen-deep); }
  .callout-body :global(p) { margin: 0 0 0.6em; max-width: none; }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
</style>
