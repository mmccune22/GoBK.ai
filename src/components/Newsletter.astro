---
import brevoFormHtml from '../lib/brevo-form.html?raw';
import { NEWSLETTER, newsletterConfig } from '../lib/newsletter.mjs';
interface Props { signup?: boolean }
const { signup = false } = Astro.props;
const { enabled, formUrl } = newsletterConfig(import.meta.env);
---
<section class="newsletter on-green" aria-label={NEWSLETTER.name} data-pagefind-ignore>
  <div class="wrap newsletter-grid">
    <div>
      <p class="eyebrow">{NEWSLETTER.name} · {NEWSLETTER.cadence}</p>
      <h2>{NEWSLETTER.promise}</h2>
      <p class="promise">Plain-English explanations, practical checklists, and questions to help you explore your options. One useful topic at a time.</p>
    </div>
    <div class="signup">
      <p class="reassurance">Free to read. No pressure. Unsubscribe anytime.</p>
      {enabled ? (
        <Fragment set:html={brevoFormHtml.replace("__BREVO_FORM_URL__", formUrl)} />
      ) : <div class="actions">
        {signup ? <button class="btn btn-primary" type="button" disabled>Signup opens soon</button> : <a class="btn btn-primary" href="/newsletter#signup">Get the guide <span aria-hidden="true">→</span></a>}
        <a class="sample" href="/newsletter/where-to-start">Read a sample</a>
      </div>}
      {(signup || enabled) && <p class="note" id="newsletter-note">{enabled ? 'Check your inbox and confirm your email to receive the first guide. Brevo handles your subscription. This experimental first issue is marked [TEST] and awaits review.' : 'Subscriptions are not open yet. Explore the sample issues while we get ready.'}</p>}
      <p class="privacy"><a href="/privacy">How we handle your information</a></p>
    </div>
  </div>
</section>
<style>
  .newsletter { background: var(--sage-deeper); color: #fff; padding-block: var(--space-5); border-radius: var(--radius); }
  .newsletter-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-5); align-items: center; }
  .eyebrow { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 0.8rem; }
  h2 { color: #fff; font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .promise { color: #fff; margin: 1rem 0 0; max-width: 48ch; }
  .reassurance { font-size: 0.95rem; margin-bottom: 1rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .signup :global(.sib-form) { padding: 0; background: transparent !important; text-align: left !important; }
  .signup :global(#sib-container) { max-width: none !important; border: 0 !important; border-radius: var(--radius) !important; padding: 1rem; }
  .signup :global(.sib-form p) { color: var(--fg); }
  .signup :global(.sib-form-message-panel--active) { display: block; margin-bottom: 1rem; }
  .signup :global(.sib-form-block__button) { background: var(--sage-deeper) !important; padding: 0.8rem 1.25rem; }
  .signup :global(.input--hidden) { display: none; }
  .sample, .privacy a { color: #fff; text-decoration-color: #ffffff80; }
  .sample { font-weight: 600; }
  .note, .privacy { font-size: 0.875rem; margin: 1rem 0 0; }
  button:disabled { opacity: 0.75; cursor: not-allowed; }
  @media (max-width: 48rem) { .newsletter-grid { grid-template-columns: 1fr; gap: var(--space-3); } }
</style>
