---
import { NEWSLETTER } from '../lib/newsletter.mjs';
---
<section class="newsletter on-green" aria-label="GoBK email guides" data-pagefind-ignore>
  <div class="wrap newsletter-inner">
    <div>
      <h2>{NEWSLETTER.promise}</h2>
      <p>Explore The GoBK Guide newsletter and our six-part Bankruptcy Getting Started email series.</p>
    </div>
    <a class="btn btn-primary" href="/newsletter/">Explore email guides <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .newsletter { background: var(--sage-deeper); color: #fff; padding-block: var(--space-5); }
  .newsletter-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  h2 { font-size: 1.625rem; color: #fff; margin: 0; }
  p { color: #fff; margin: 0.75rem 0 0; max-width: 44rem; }
  .btn-primary { background: #fff; color: var(--sage-deeper); border-color: #fff; flex-shrink: 0; }
  .btn-primary:hover { background: var(--off); }
  @media (max-width: 48rem) { .newsletter-inner { flex-direction: column; align-items: flex-start; } }
</style>
