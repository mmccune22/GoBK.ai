---
/** Box wordmark: sage tile, white type. A quiet nod to the BKFL / BKFP marks. */
interface Props { class?: string; size?: 'default' | 'small' }
const { class: cls, size = 'default' } = Astro.props;
---
<a href="/" class:list={['wordmark', size, cls]} aria-label="GoBK home">GoBK</a>
<style>
  .wordmark {
    display: inline-block;
    background: var(--sage);
    color: #fff;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    line-height: 1;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
  }
  .wordmark:hover { background: var(--sage-deep); }
  .small { font-size: 1.125rem; padding: 0.45rem 0.7rem; }
</style>
