---
/** GoBK logo: open-book mark + wordmark. `onDark` swaps to the white-text version for dark backgrounds. */
interface Props { class?: string; size?: 'default' | 'small'; onDark?: boolean }
const { class: cls, size = 'default', onDark = false } = Astro.props;
const src = onDark ? '/logo-on-dark.png' : '/logo.png';
---
<a href="/" class:list={['wordmark', size, cls]} aria-label="GoBK home">
  <img src={src} alt="GoBK" width="353" height="180" />
</a>
<style>
  .wordmark { display: inline-block; line-height: 0; text-decoration: none; }
  .wordmark img { height: 58px; width: auto; display: block; }
  .small img { height: 48px; }
  @media (max-width: 40rem) { .wordmark img { height: 46px; } }
</style>
