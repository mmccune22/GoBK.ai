---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Marks the page as searchable by Pagefind (articles, categories, doors). */
  searchable?: boolean;
  /** Use the dark header variant (homepage). */
  darkHeader?: boolean;
  canonical?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, searchable = false, jsonLd } = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'GoBK' ? 'GoBK' : `${title} | GoBK`;
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'GoBK', url: SITE.url, description: 'Bankruptcy answers and options. Free, plain-English information about bankruptcy and the alternatives to it.' },
    { '@type': 'Organization', name: 'GoBK', url: SITE.url, email: 'hello@gobk.ai', logo: `${SITE.url}/og.png` },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GoBK" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og.png`} />
    {SITE.searchConsole && <meta name="google-site-verification" content={SITE.searchConsole} />}
    <meta name="theme-color" content="#173C35" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {SITE.ga4 && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>}
    {SITE.ga4 && <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${SITE.ga4}');`} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
