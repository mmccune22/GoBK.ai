---
import Base from '../layouts/Base.astro';

const questions = [
  { title: 'Are you married?', asks: 'Yes or no.', branch: 'No goes to Question 2. Yes opens “Would your spouse file with you?” with yes, no and not sure choices.', video: ['Marriage and spouse filing', 'https://vimeo.com/1118890037/f9c387612f?ts=16000&share=copy'], use: 'Adds household and joint-debt preparation. It does not decide who should file.' },
  { title: 'Have you ever filed for bankruptcy before?', asks: 'Yes or no.', branch: 'No goes to Question 3. Yes opens “How long ago did you file?” with more than 8 years, less than 8 years and not sure choices.', video: ['Prior bankruptcy', 'https://vimeo.com/1118894211?share=copy'], use: 'Moves individual review first. The timing range does not calculate a waiting period.' },
  { title: 'How many people live in your household?', asks: 'One (just me), two, three, four or five or more.', branch: 'Every choice continues to Question 4.', video: ['Household size', 'https://vimeo.com/1119139723?share=copy'], use: 'Organizes household facts for a consultation. It is not a legal household-size determination.' },
  { title: 'What is the total gross household income per month?', asks: 'Less than $4,000; $4,000–$6,000; $6,000–$8,000; $8,000–$10,000; $10,000–$12,000; $12,000–$14,000; $14,000–$16,000; or $16,000 or more.', branch: 'Every choice continues to Question 5. The PDF then proposes an annualized median-income check.', video: ['Gross household income', 'https://vimeo.com/1119141960?share=copy'], use: 'The beta preserves the income band as context. It does not multiply it by twelve, perform a means test or use a dated median table.' },
  { title: 'Do you own a home?', asks: 'Yes or no.', branch: 'No goes to Question 6. Yes asks whether mortgage payments are current, then asks how much equity may be in the home.', video: ['Home, mortgage and equity', 'https://vimeo.com/1119148834/ad43f572d9?share=copy'], use: 'Past-due payments can affect the discussion path. Equity adds a property-review question but does not establish an exemption.' },
  { title: 'Do you have a vehicle?', asks: 'Yes or no.', branch: 'No goes to Question 7. Yes asks whether car payments are current, then asks how much equity may be in the vehicle.', video: ['Vehicle, loan and equity', 'https://vimeo.com/1119152283?share=copy'], use: 'Past-due payments can affect the discussion path. Equity adds a property-review question but does not establish an exemption.' },
  { title: 'Do you have any other significant assets?', asks: 'Yes or no.', branch: 'No goes to Question 8. The PDF associates Yes with an assets video.', video: ['Other significant assets', 'https://vimeo.com/1119155302?share=copy'], use: 'Raises the priority of a complete property review without deciding what is protected.' },
  { title: 'Do you owe any taxes?', asks: 'Yes or no.', branch: 'No goes to Question 9. The PDF associates Yes with a tax-complications video.', video: ['Taxes', 'https://vimeo.com/1119157707?share=copy'], use: 'Adds tax-specific preparation and keeps debt treatment unresolved.' },
  { title: 'Do you owe any child support or alimony?', asks: 'Yes or no.', branch: 'No goes to Question 10. The PDF associates Yes with a domestic-support-obligation video.', video: ['Child support or alimony', 'https://vimeo.com/1119159473?share=copy'], use: 'Adds support-specific preparation and keeps debt treatment unresolved.' },
  { title: 'Do you owe any student loans?', asks: 'Yes or no.', branch: 'No goes to Question 11. The PDF associates Yes with a student-loan video.', video: ['Student loans', 'https://vimeo.com/1119164662?share=copy'], use: 'Adds student-loan preparation and keeps debt treatment unresolved.' },
  { title: 'Do you owe credit cards, personal loans, lines of credit, medical bills or other unsecured debt?', asks: 'Yes or no.', branch: 'Either answer completes the numbered questions. The PDF associates Yes with an unsecured-debt video and then moves to the report.', video: ['Unsecured debt', 'https://vimeo.com/1119167300?share=copy'], use: 'Adds ordinary-unsecured-debt preparation. The category alone does not establish discharge or chapter eligibility.' },
];

const guidePlan = [
  { title: 'Landing and trust notice', source: 'The PDF proposes a “Four Minutes to a Free Bankruptcy Case Analysis” hero, a Start button, an intro video, contact and location fields, a trust notice, a three-step explanation and draft social proof.', beta: 'The beta puts the Checkup first, keeps the legal-information boundaries and intro context, and omits contact collection, location collection and unverified social-proof or confidentiality claims.' },
  { title: 'Eleven numbered questions', source: 'The PDF starts with marriage, then prior bankruptcy, household, gross income, property and five debt topics. Marriage, prior filing, home and vehicle answers open conditional follow-ups.', beta: 'The beta keeps that order and those conditional follow-ups. A skipped follow-up remains not applicable; it is not silently changed into a substantive answer.' },
  { title: 'Topic videos', source: 'The PDF links one intro video and one video for each numbered topic. It places several videos on a Yes branch but does not define an exact player interaction.', beta: 'The questionnaire does not interrupt each answer with a video. After the report it offers up to three relevant videos. Videos are optional and never change the graph result.' },
  { title: 'Issue report and legal help', source: 'After Question 11 the PDF says only “ISSUE REPORT?”, points to a ZIP-based attorney search and supplies reminder and disclaimer language. It does not define report calculations or a report layout.', beta: 'The deterministic graph returns a bounded issue list, a chapter discussion starting point, next questions and explicit limitations. It does not match attorneys, collect a ZIP Code or turn the short form into legal advice.' },
];

const graphSteps = [
  { id: 'validate_and_preserve_urgency', title: 'Check the answers and keep urgent concerns', body: 'Accept only supported structured values. Unknown stays unknown, and a valid urgent concern survives another invalid answer.' },
  { id: 'load_capabilities', title: 'Load enabled capabilities', body: 'The trusted runtime enables a budget snapshot and educational guidance. No eligibility, exemption or discharge rule pack is enabled.' },
  { id: 'plan_supported_work', title: 'Plan supported calculations', body: 'Decide which optional budget comparisons have enough information and prevent a payment from being counted twice.' },
  { id: 'calculate_snapshot', title: 'Calculate the optional snapshot', body: 'Use integer-cent arithmetic for take-home income, expenses and separately reported payments. This calculation does not choose a chapter.' },
  { id: 'record_legal_limits', title: 'Record the legal limits', body: 'Keep means-test eligibility, property protection, debt treatment and filing advice explicitly unresolved.' },
  { id: 'assemble_findings', title: 'Build the issue list and discussion path', body: 'Apply fixed TypeScript branches to the validated goals, debts, income pattern, arrears, earlier case and other reported concerns. Add matching consultation questions.' },
  { id: 'render_result', title: 'Assemble the public result', body: 'Return urgent warnings, the discussion starting point, issue list, next steps, reliable reading and limitations.' },
  { id: 'validate_public_result', title: 'Check the result contract', body: 'Reject malformed output instead of displaying stale, raw or guessed information.' },
];

const decisionBranches = [
  ['Earlier bankruptcy reported', 'Review the earlier case before ranking chapters. The chapter, filing date, disposition and discharge history still need individual review.'],
  ['Required discussion fact missing or invalid', 'Clarify the fact first. Missing is never changed to no, zero or a reassuring assumption.'],
  ['Student loans, taxes, support or another special debt selected', 'Compare both chapters with debt-specific advice because the debt label alone does not show what will remain.'],
  ['Property answers conflict or both secured loans are behind', 'Compare both chapters and resolve the property facts before placing one chapter first.'],
  ['Regular income, one matching secured loan behind and a goal to keep that property', 'Start by discussing Chapter 13 and whether ongoing and plan payments could be sustained.'],
  ['Only ordinary unsecured debts, a debt-relief goal, no secured arrears and no earlier case', 'Start by discussing Chapter 7, while preserving separate eligibility and property review.'],
  ['No current income and a goal to keep property that is behind', 'Review payment feasibility before treating a Chapter 13 plan as workable.'],
  ['Any other supported combination', 'Compare Chapter 7, Chapter 13 and nonbankruptcy options without forcing a chapter label.'],
];
---

<Base title="Bankruptcy Checkup Beta Workflow" description="How the attached guide's landing plan, eleven questions, conditional branches, videos and issue report map to the deterministic Bankruptcy Checkup beta.">
  <section class="section workflow-page">
    <div class="wrap">
      <header class="intro">
        <p class="k">HOW THE BETA WORKS</p>
        <h1>From the attached guide to the working beta</h1>
        <p class="lede">The PDF is a written workflow, not a finished app mockup. It defines a landing-page plan, eleven numbered questions, six conditional follow-ups, topic videos and an unfinished issue-report step. This page shows what the beta reproduces and what it safely substitutes.</p>
        <p class="boundary"><strong>General information only.</strong> It does not decide whether someone should file, whether a chapter is available, what property is protected or which debts will be discharged.</p>
        <div class="actions"><a class="btn btn-primary" href="/bankruptcy-checkup-beta-v2">Try Beta V2</a><a class="btn btn-secondary" href="/bankruptcy-checkup-beta-workflow-interactive">Change invented answers in the workflow lab</a></div>
      </header>

      <section class="workflow-block" aria-labelledby="guide-plan-heading">
        <h2 id="guide-plan-heading">The PDF-defined experience and this beta</h2>
        <div class="experience-grid">
          {guidePlan.map((part) => (
            <article><h3>{part.title}</h3><p><strong>PDF plan:</strong> {part.source}</p><p><strong>Beta implementation:</strong> {part.beta}</p></article>
          ))}
        </div>
        <p class="soft">The PDF's separate <a href="https://vimeo.com/1118874879?share=copy" target="_blank" rel="noopener noreferrer">intro video ↗</a> is a source reference. It does not alter the questionnaire or graph.</p>
        <p class="soft">The source document's branch arrows, all-caps implementation notes, bracketed buttons and placeholder media claims are specifications, not consumer-facing copy. The beta keeps the useful flow without publishing those drafting notes as if they were completed features.</p>
      </section>

      <figure class="flow-overview" aria-label="Eleven guide answers go through eight fixed LangGraph steps and return a checked educational result">
        <div><span>INPUT</span><strong>Eleven guide questions</strong><small>Plus the spouse, prior-case, mortgage, home-equity, car-payment and vehicle-equity follow-ups when applicable</small></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div><span>PROCESS</span><strong>Eight graph nodes</strong><small>Validate → plan → calculate → explain → check</small></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div><span>OUTPUT</span><strong>A bounded issue report</strong><small>Issue list, chapter discussion, next questions, reading and unresolved limits</small></div>
        <figcaption>The same supported answers follow the same route. There is no language model, random choice, tracing or saved assessment session in the consumer flow.</figcaption>
      </figure>

      <section class="workflow-block" aria-labelledby="questions-heading">
        <h2 id="questions-heading">The attached guide's question order</h2>
        <ol class="question-list">
          {questions.map((question, index) => (
            <li><span class="question-number" aria-hidden="true">{index + 1}</span><div><h3>{question.title}</h3><p><strong>Answers:</strong> {question.asks}</p><p><strong>PDF branch:</strong> {question.branch}</p><p><strong>PDF video:</strong> <a href={question.video[1]} target="_blank" rel="noopener noreferrer">{question.video[0]} ↗</a></p><p><strong>Beta handling:</strong> {question.use}</p></div></li>
          ))}
        </ol>
        <p class="soft"><strong>The six conditional follow-ups belong to Questions 1, 2, 5 and 6.</strong> No separate goal or income-regularity question is part of the PDF-derived V2 questionnaire. The interactive lab exposes additional invented graph context separately so the decision engine can be reviewed without presenting those fields as source questions.</p>
      </section>

      <section class="workflow-block decision-block" aria-labelledby="decision-heading">
        <h2 id="decision-heading">The deterministic chapter discussion tree</h2>
        <p>The first matching branch sets what to discuss first. A discussion starting point is not eligibility or a filing recommendation. Beta V2 sends the answers it actually displays and leaves unasked goal, urgency and income-pattern context unknown; the workflow lab exposes those extra engine fields for testing.</p>
        <ol class="decision-list">
          {decisionBranches.map(([condition, result]) => <li><strong>{condition}:</strong> {result}</li>)}
        </ol>
        <p class="soft">Household size, the gross-income band, equity and the eight-year timing range never produce a legal verdict. They organize facts for review. A real means test, applicable exemptions and prior-case timing require more information and current law.</p>
      </section>

      <section class="workflow-block" aria-labelledby="attorney-heading">
        <h2 id="attorney-heading">What the issue report can say</h2>
        <div class="answer-grid">
          <article><h3>Show the reported issues</h3><p>The report can flag an earlier case, property or payment concerns, other assets, taxes, support, student loans and unsecured debt.</p></article>
          <article><h3>Keep legal conclusions open</h3><p>The PDF's short answers cannot establish eligibility, exemptions, waiting periods, discharge or whether someone should file.</p></article>
          <article><h3>Clarify before choosing</h3><p>Unknown or invalid facts remain visible. The graph does not fill gaps with assumptions or hidden consumer answers.</p></article>
          <article><h3>Point toward qualified help</h3><p>The report provides questions and records for a consultation. It does not collect a ZIP Code, match an attorney or certify a case as simple.</p></article>
        </div>
        <p class="soft"><strong>The attachment leaves the report unfinished.</strong> Its only report heading is “ISSUE REPORT?” followed by an attorney-search note and disclaimer text. The structured result shown in the beta is therefore a bounded implementation choice, not a report design copied from the PDF.</p>
      </section>

      <section class="workflow-block" aria-labelledby="nodes-heading">
        <h2 id="nodes-heading">The eight LangGraph nodes</h2>
        <p>A node is one controlled step. State is the validated information carried between steps, and an edge points to the next step.</p>
        <ol class="workflow-list">
          {graphSteps.map((step, index) => (
            <li data-workflow-step={step.id}><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p><code>{step.id}</code></div></li>
          ))}
        </ol>
      </section>

      <section class="workflow-block limits-block" aria-labelledby="limits-heading">
        <h2 id="limits-heading">What this version deliberately does not do</h2>
        <ul>
          <li>It does not collect a name, email, phone number, Social Security number, account number or documents.</li>
          <li>It does not multiply the income band by twelve or compare it with a median-income table.</li>
          <li>It does not apply state or federal exemption amounts to the reported equity.</li>
          <li>It does not turn “more or less than eight years” into a filing or discharge waiting-period answer.</li>
          <li>It does not determine discharge, calculate a Chapter 13 payment or promise that property can be kept.</li>
        </ul>
        <p>The result instead explains what remains unresolved and what records or questions could make a professional consultation more useful.</p>
      </section>

      <section class="workflow-block tools-block" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Where LangChain fits</h2>
        <p><strong>LangGraph organizes the process.</strong> It runs the eight named nodes and carries fresh state from one node to the next. Ordinary TypeScript performs every calculation and branch.</p>
        <p><strong>The interactive workflow lab is a review tool.</strong> It bundles the same LangGraph library and engine source so Matt and Jimmy can change invented answers, inspect the projected state and compare a draft graph with the current baseline. It does not call the public Checkup server or save consumer answers.</p>
        <p><a href="/bankruptcy-checkup-beta-workflow-interactive">Open the interactive workflow lab</a> or return to <a href="/bankruptcy-checkup-beta-v2">Bankruptcy Checkup Beta V2</a>.</p>
      </section>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 64rem; }
  h1 { margin-bottom: var(--space-3); }
  h2 { margin-bottom: var(--space-3); }
  h3 { margin-bottom: .55rem; }
  .lede { font-size: clamp(1.15rem, 2.3vw, 1.4rem); max-width: 62ch; }
  .boundary { padding: 1rem 1.2rem; border-left: 4px solid var(--sage); background: var(--off); max-width: 72ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .flow-overview { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 1rem; margin: 3rem 0; padding: 1.5rem; background: var(--grey); border-radius: var(--radius); }
  .flow-overview div { min-width: 0; }
  .flow-overview div > span { display: block; font-size: .78rem; letter-spacing: .07em; font-weight: 700; color: var(--sage-deep); }
  .flow-overview strong, .flow-overview small { display: block; }
  .flow-overview strong { margin-block: .4rem; font-size: 1.15rem; }
  .flow-overview small { line-height: 1.5; }
  .flow-arrow { font-size: 1.8rem; color: var(--sage-deep); }
  figcaption { grid-column: 1 / -1; border-top: 1px solid var(--rule); padding-top: 1rem; font-size: .92rem; }
  .workflow-block { margin-top: var(--space-6); }
  .experience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .experience-grid article { padding: 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--white); }
  .experience-grid article p:last-child { margin-bottom: 0; }
  .question-list, .workflow-list { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .question-list li, .workflow-list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding-bottom: 1.25rem; }
  .question-list li > div, .workflow-list li > div { padding: 1.1rem 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--white); }
  .question-list p, .workflow-list p { margin-block: .35rem; max-width: 76ch; }
  .question-number, .step-number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--sage-deep); color: #fff; font-weight: 700; }
  .workflow-list code { display: block; margin-top: .75rem; font-size: .8rem; overflow-wrap: anywhere; color: var(--sage-deep); }
  .decision-block, .limits-block, .tools-block { padding: clamp(1.25rem, 4vw, 2.2rem); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--off); }
  .decision-list li, .limits-block li { padding-bottom: .7rem; max-width: 78ch; }
  .soft { color: var(--fg-soft); }
  .answer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .answer-grid article { padding: 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); }
  .answer-grid article p { margin-bottom: 0; }
  @media (max-width: 45rem) {
    .flow-overview, .experience-grid, .answer-grid { grid-template-columns: 1fr; }
    .flow-arrow { transform: rotate(90deg); justify-self: start; }
    .question-list li, .workflow-list li { grid-template-columns: 2.2rem minmax(0, 1fr); gap: .65rem; }
    .question-number, .step-number { width: 2.2rem; height: 2.2rem; }
  }
</style>
