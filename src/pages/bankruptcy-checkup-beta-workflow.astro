---
import Base from '../layouts/Base.astro';

const questions = [
  { title: 'Urgent issues', asks: 'Foreclosure, garnishment, repossession, a creditor lawsuit or another legal deadline.', use: 'Moves prompt legal help to the front. It never calculates or changes a deadline.' },
  { title: 'Main goal', asks: 'Debt relief, keeping a home, keeping a vehicle, dealing with creditors or still unsure.', use: 'Helps frame the chapter discussion and consultation questions.' },
  { title: 'Marriage', asks: 'Whether the person is married and, if so, whether the spouse may file too.', use: 'Adds household and joint-debt preparation. It does not decide who should file.' },
  { title: 'Household and income', asks: 'Household size, a broad gross monthly income range and whether income is regular.', use: 'Income regularity can affect the discussion path. The range and household size are preparation facts, not a means test.' },
  { title: 'Home', asks: 'Ownership, mortgage status and whether there may be equity.', use: 'Past-due mortgage payments can affect the discussion path. Equity only adds a property-review question.' },
  { title: 'Vehicle', asks: 'Ownership, loan status and whether there may be equity.', use: 'Past-due vehicle payments can affect the discussion path. Equity does not establish an exemption.' },
  { title: 'Other significant property', asks: 'Whether other valuable property may need review.', use: 'Raises the priority of a complete property review without deciding what is protected.' },
  { title: 'Debt types', asks: 'Common unsecured debts, mortgage, vehicle loan, student loans, taxes, support or another debt.', use: 'Selects debt-specific questions. Some debt types require separate advice before ranking chapters.' },
  { title: 'Payment pressure', asks: 'Keeping up, falling behind, borrowing for basics or paying without reducing balances.', use: 'Explains why bankruptcy and other options may be worth comparing.' },
  { title: 'Earlier bankruptcy', asks: 'Whether there was an earlier case and a broad timing range.', use: 'An earlier case moves individual review first. The timing range does not calculate a waiting period.' },
];

const graphSteps = [
  { id: 'validate_and_preserve_urgency', title: 'Check the answers and keep urgent concerns', body: 'Accept only supported structured values. Unknown stays unknown, and a valid urgent concern survives another invalid answer.' },
  { id: 'load_capabilities', title: 'Load enabled capabilities', body: 'The trusted runtime enables a budget snapshot and educational guidance. No eligibility, exemption or discharge rule pack is enabled.' },
  { id: 'plan_supported_work', title: 'Plan supported calculations', body: 'Decide which optional budget comparisons have enough information and prevent a payment from being counted twice.' },
  { id: 'calculate_snapshot', title: 'Calculate the optional snapshot', body: 'Use integer-cent arithmetic for take-home income, expenses and separately reported payments. This calculation does not choose a chapter.' },
  { id: 'record_legal_limits', title: 'Record the legal limits', body: 'Keep means-test eligibility, property protection, debt treatment and filing advice explicitly unresolved.' },
  { id: 'assemble_findings', title: 'Build the issue list and discussion path', body: 'Apply fixed TypeScript branches to the validated goals, debts, income pattern, arrears, earlier case and other reported concerns. Add matching consultation questions.' },
  { id: 'render_result', title: 'Assemble the public result', body: 'Return urgent warnings, the discussion starting point, issue list, next steps, reliable reading and limitations.' },
  { id: 'validate_public_result', title: 'Check the result contract', body: 'Reject malformed output instead of displaying stale, raw or guessed information.' },
];

const decisionBranches = [
  ['Earlier bankruptcy reported', 'Review the earlier case before ranking chapters. The chapter, filing date, disposition and discharge history still need individual review.'],
  ['Required discussion fact missing or invalid', 'Clarify the fact first. Missing is never changed to no, zero or a reassuring assumption.'],
  ['Student loans, taxes, support or another special debt selected', 'Compare both chapters with debt-specific advice because the debt label alone does not show what will remain.'],
  ['Property answers conflict or both secured loans are behind', 'Compare both chapters and resolve the property facts before placing one chapter first.'],
  ['Regular income, one matching secured loan behind and a goal to keep that property', 'Start by discussing Chapter 13 and whether ongoing and plan payments could be sustained.'],
  ['Only ordinary unsecured debts, a debt-relief goal, no secured arrears and no earlier case', 'Start by discussing Chapter 7, while preserving separate eligibility and property review.'],
  ['No current income and a goal to keep property that is behind', 'Review payment feasibility before treating a Chapter 13 plan as workable.'],
  ['Any other supported combination', 'Compare Chapter 7, Chapter 13 and nonbankruptcy options without forcing a chapter label.'],
];
---

<Base title="Bankruptcy Checkup Beta Workflow" description="How ten structured Checkup questions move through eight deterministic LangGraph steps to produce a bounded issue list and discussion starting point.">
  <section class="section workflow-page">
    <div class="wrap">
      <header class="intro">
        <p class="k">HOW THE BETA WORKS</p>
        <h1>From ten questions to a starting point</h1>
        <p class="lede">The Checkup sends structured answers to the hosted LangGraph. The graph validates them, runs fixed calculations and branches, and returns an issue list and questions to discuss with a qualified attorney.</p>
        <p class="boundary"><strong>General information only.</strong> It does not decide whether someone should file, whether a chapter is available, what property is protected or which debts will be discharged.</p>
        <div class="actions"><a class="btn btn-primary" href="/bankruptcy-checkup-beta-v2">Try Beta V2</a><a class="btn btn-secondary" href="/bankruptcy-checkup-beta-workflow-interactive">Change invented answers in the workflow lab</a></div>
      </header>

      <figure class="flow-overview" aria-label="Ten answers go through eight fixed LangGraph steps and return a checked educational result">
        <div><span>INPUT</span><strong>Ten short steps</strong><small>Urgency, goals, household, property, debts, payments and an earlier case</small></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div><span>PROCESS</span><strong>Eight graph nodes</strong><small>Validate → plan → calculate → explain → check</small></div>
        <span class="flow-arrow" aria-hidden="true">→</span>
        <div><span>OUTPUT</span><strong>A bounded starting point</strong><small>Urgency, issue list, chapter discussion and next questions</small></div>
        <figcaption>The same supported answers follow the same route. There is no language model, random choice, tracing or saved assessment session in the consumer flow.</figcaption>
      </figure>

      <section class="workflow-block" aria-labelledby="questions-heading">
        <h2 id="questions-heading">What each question changes</h2>
        <ol class="question-list">
          {questions.map((question, index) => (
            <li><span class="question-number" aria-hidden="true">{index + 1}</span><div><h3>{question.title}</h3><p><strong>Asks:</strong> {question.asks}</p><p><strong>Used for:</strong> {question.use}</p></div></li>
          ))}
        </ol>
      </section>

      <section class="workflow-block decision-block" aria-labelledby="decision-heading">
        <h2 id="decision-heading">The deterministic chapter discussion tree</h2>
        <p>The first matching branch sets what to discuss first. A discussion starting point is not eligibility or a filing recommendation.</p>
        <ol class="decision-list">
          {decisionBranches.map(([condition, result]) => <li><strong>{condition}:</strong> {result}</li>)}
        </ol>
        <p class="soft">Household size, the gross-income band, equity and the eight-year timing range never produce a legal verdict. They organize facts for review. A real means test, applicable exemptions and prior-case timing require more information and current law.</p>
      </section>

      <section class="workflow-block" aria-labelledby="attorney-heading">
        <h2 id="attorney-heading">How attorney-help priority is chosen</h2>
        <div class="answer-grid">
          <article><h3>Prompt help</h3><p>A reported deadline, lawsuit, garnishment, foreclosure or repossession puts prompt qualified help first.</p></article>
          <article><h3>Individual review is especially useful</h3><p>An earlier case, property concern, special debt or significant property raises issues this short form cannot resolve.</p></article>
          <article><h3>Clarify before choosing</h3><p>Unknown or invalid facts remain visible. The graph does not fill gaps with assumptions.</p></article>
          <article><h3>Advice remains recommended</h3><p>Even the narrower Chapter 7 discussion path does not certify a case as simple or safe to handle without advice.</p></article>
        </div>
      </section>

      <section class="workflow-block" aria-labelledby="nodes-heading">
        <h2 id="nodes-heading">The eight LangGraph nodes</h2>
        <p>A node is one controlled step. State is the validated information carried between steps, and an edge points to the next step.</p>
        <ol class="workflow-list">
          {graphSteps.map((step, index) => (
            <li data-workflow-step={step.id}><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p><code>{step.id}</code></div></li>
          ))}
        </ol>
      </section>

      <section class="workflow-block limits-block" aria-labelledby="limits-heading">
        <h2 id="limits-heading">What this version deliberately does not do</h2>
        <ul>
          <li>It does not collect a name, email, phone number, Social Security number, account number or documents.</li>
          <li>It does not multiply the income band by twelve or compare it with a median-income table.</li>
          <li>It does not apply state or federal exemption amounts to the reported equity.</li>
          <li>It does not turn “more or less than eight years” into a filing or discharge waiting-period answer.</li>
          <li>It does not determine discharge, calculate a Chapter 13 payment or promise that property can be kept.</li>
        </ul>
        <p>The result instead explains what remains unresolved and what records or questions could make a professional consultation more useful.</p>
      </section>

      <section class="workflow-block tools-block" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Where LangChain fits</h2>
        <p><strong>LangGraph organizes the process.</strong> It runs the eight named nodes and carries fresh state from one node to the next. Ordinary TypeScript performs every calculation and branch.</p>
        <p><strong>The interactive workflow lab is a review tool.</strong> It bundles the same LangGraph library and engine source so Matt and Jimmy can change invented answers, inspect the projected state and compare a draft graph with the current baseline. It does not call the public Checkup server or save consumer answers.</p>
        <p><a href="/bankruptcy-checkup-beta-workflow-interactive">Open the interactive workflow lab</a> or return to <a href="/bankruptcy-checkup-beta-v2">Bankruptcy Checkup Beta V2</a>.</p>
      </section>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 64rem; }
  h1 { margin-bottom: var(--space-3); }
  h2 { margin-bottom: var(--space-3); }
  h3 { margin-bottom: .55rem; }
  .lede { font-size: clamp(1.15rem, 2.3vw, 1.4rem); max-width: 62ch; }
  .boundary { padding: 1rem 1.2rem; border-left: 4px solid var(--sage); background: var(--off); max-width: 72ch; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .flow-overview { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 1rem; margin: 3rem 0; padding: 1.5rem; background: var(--grey); border-radius: var(--radius); }
  .flow-overview div { min-width: 0; }
  .flow-overview div > span { display: block; font-size: .78rem; letter-spacing: .07em; font-weight: 700; color: var(--sage-deep); }
  .flow-overview strong, .flow-overview small { display: block; }
  .flow-overview strong { margin-block: .4rem; font-size: 1.15rem; }
  .flow-overview small { line-height: 1.5; }
  .flow-arrow { font-size: 1.8rem; color: var(--sage-deep); }
  figcaption { grid-column: 1 / -1; border-top: 1px solid var(--rule); padding-top: 1rem; font-size: .92rem; }
  .workflow-block { margin-top: var(--space-6); }
  .question-list, .workflow-list { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .question-list li, .workflow-list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding-bottom: 1.25rem; }
  .question-list li > div, .workflow-list li > div { padding: 1.1rem 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--white); }
  .question-list p, .workflow-list p { margin-block: .35rem; max-width: 76ch; }
  .question-number, .step-number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--sage-deep); color: #fff; font-weight: 700; }
  .workflow-list code { display: block; margin-top: .75rem; font-size: .8rem; overflow-wrap: anywhere; color: var(--sage-deep); }
  .decision-block, .limits-block, .tools-block { padding: clamp(1.25rem, 4vw, 2.2rem); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--off); }
  .decision-list li, .limits-block li { padding-bottom: .7rem; max-width: 78ch; }
  .soft { color: var(--fg-soft); }
  .answer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .answer-grid article { padding: 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); }
  .answer-grid article p { margin-bottom: 0; }
  @media (max-width: 45rem) {
    .flow-overview, .answer-grid { grid-template-columns: 1fr; }
    .flow-arrow { transform: rotate(90deg); justify-self: start; }
    .question-list li, .workflow-list li { grid-template-columns: 2.2rem minmax(0, 1fr); gap: .65rem; }
    .question-number, .step-number { width: 2.2rem; height: 2.2rem; }
  }
</style>
