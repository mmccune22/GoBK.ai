---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { NEWSLETTER, newsletterEmails } from '../../lib/newsletter.mjs';
const issues = newsletterEmails.filter((email) => email.number);
---
<Base title={NEWSLETTER.name} description="Debt questions. Clear answers. A free, twice-monthly guide to understanding debt and bankruptcy and preparing for an attorney conversation.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="k">THE GOBK GUIDE</p>
        <h1>Debt questions.<br /><span>Clear answers.</span></h1>
        <p class="lede">A calmer place to start. Twice a month, we explain one topic in plain English and help you prepare for the next conversation.</p>
        <div class="actions"><a class="btn btn-primary" href="#signup">Get the guide <span aria-hidden="true">→</span></a><a href="/newsletter/where-to-start">Read the first issue</a></div>
        <p class="small soft">Free. Written for people exploring their options. No pressure to file.</p>
      </div>
      <aside class="issue-preview" aria-label="First issue preview">
        <div class="preview-top"><strong>The GoBK Guide</strong><span>ISSUE 01 · DRAFT</span></div>
        <p class="k">A QUESTION YOU MIGHT BE ASKING</p>
        <h2>Debt feels overwhelming. Where do you start?</h2>
        <p>You don’t have to understand everything today. Start with your questions.</p>
        <ul><li>What do I most want to understand?</li><li>What should I bring to a conversation?</li><li>What could my next step look like?</li></ul>
        <a href="/newsletter/where-to-start">Take a look inside <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>
  <section class="section"><div class="wrap">
    <div class="section-heading"><p class="k">SMALL EMAILS. USEFUL ANSWERS.</p><h2>A little clarity, twice a month.</h2></div>
    <div class="benefits">
      <div><span class="number">01</span><h3>One clear explanation</h3><p>We take one common question and explain it in everyday language.</p></div>
      <div><span class="number">02</span><h3>One practical checklist</h3><p>A short list to help you organize your thoughts and prepare your questions.</p></div>
      <div><span class="number">03</span><h3>One next step</h3><p>Something useful to read or ask about, without rushing a decision.</p></div>
    </div>
  </div></section>
  <section class="section issues"><div class="wrap">
    <p class="k">EXPLORE THE FIRST FOUR ISSUES</p><h2>Start wherever you are.</h2>
    <p class="soft">These sample issues are editorial drafts awaiting Matt’s review.</p>
    <ol class="issue-list">{issues.map((issue) => <li><a href={`/newsletter/${issue.slug}`}><span class="issue-number">{String(issue.number).padStart(2, '0')}</span><div><h3>{issue.subject}</h3><p>{issue.preheader}</p></div><span aria-hidden="true">↗</span></a></li>)}</ol>
    <a class="welcome-link" href="/newsletter/welcome">Preview the welcome email</a>
  </div></section>
  <div id="signup" class="signup-section"><Newsletter signup /></div>
  <section class="section"><div class="wrap faq">
    <h2>A few things to know.</h2>
    <details><summary>Who is this for?</summary><p>People dealing with debt, considering bankruptcy, or preparing to talk with an attorney. No legal background needed.</p></details>
    <details><summary>Does signing up mean I’m choosing bankruptcy?</summary><p>No. The guide helps you understand the conversation and explore your options. Signing up is simply a request for educational emails.</p></details>
    <details><summary>Do I need to share my financial situation?</summary><p>No. Signup asks only for your email address and newsletter consent. Keep account numbers, documents, and private financial details out of newsletter replies.</p></details>
    <details><summary>How often will I hear from you?</summary><p>Twice a month once the guide launches. Each issue focuses on one question. You can unsubscribe using the link in any newsletter email.</p></details>
    <p class="small soft legal">{NEWSLETTER.disclaimer}</p>
  </div></section>
</Base>
<style>
  .hero { padding-block: var(--space-6); background: var(--off); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-6); align-items: center; }
  h1 { font-size: clamp(2.5rem, 5vw, 4.25rem); }
  h1 span { color: var(--sage-deep); }
  .lede { margin: 1.5rem 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .small { font-size: 0.9rem; margin-top: 1rem; }
  .issue-preview { padding: var(--space-4); border: 1px solid var(--rule); border-top: 5px solid var(--sage); border-radius: var(--radius); background: #fff; box-shadow: 0 16px 40px #4343430c; }
  .preview-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--rule); }
  .preview-top span { font-size: 0.75rem; color: var(--fg-soft); align-self: center; }
  .issue-preview h2 { font-size: 1.7rem; margin-bottom: 1rem; }
  .issue-preview ul { padding-left: 1.25rem; font-size: 0.95rem; line-height: 1.8; margin-bottom: 1.5rem; }
  .section-heading { margin-bottom: var(--space-4); }
  .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .benefits > div { border-top: 1px solid var(--rule); padding-top: var(--space-3); }
  .number { display: block; color: var(--sage-deep); margin-bottom: 1rem; font-size: 0.85rem; font-weight: 600; }
  .benefits h3 { margin-bottom: 0.75rem; }
  .benefits p { color: var(--fg-soft); font-size: 1rem; }
  .issues { background: var(--off); }
  .issues h2 { margin-bottom: 0.75rem; }
  .issue-list { list-style: none; padding: 0; margin: 2rem 0 1rem; border-top: 1px solid var(--rule); }
  .issue-list a { display: grid; grid-template-columns: 2.5rem 1fr 1rem; gap: 1rem; align-items: center; color: var(--ink); text-decoration: none; padding: 1.5rem 0; border-bottom: 1px solid var(--rule); }
  .issue-list a:hover h3 { color: var(--sage-deep); text-decoration: underline; }
  .issue-number { color: var(--sage-deep); font-size: 0.9rem; }
  .issue-list h3 { font-size: 1.2rem; }
  .issue-list p { font-size: 0.95rem; color: var(--fg-soft); margin: 0.5rem 0 0; }
  .welcome-link { display: inline-block; margin-top: 1rem; }
  .signup-section { scroll-margin-top: 1rem; }
  .faq { max-width: 48rem; }
  .faq h2 { margin-bottom: 1.5rem; }
  details { border-top: 1px solid var(--rule); padding-block: 1.25rem; }
  summary { cursor: pointer; font-weight: 600; }
  details p { margin: 1rem 0 0; }
  .legal { border-top: 1px solid var(--rule); padding-top: 1.5rem; }
  @media (max-width: 48rem) { .hero-grid { grid-template-columns: 1fr; gap: var(--space-4); } .benefits { grid-template-columns: 1fr; gap: var(--space-3); } }
</style>
